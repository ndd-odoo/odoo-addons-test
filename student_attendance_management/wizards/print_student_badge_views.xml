<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="print_student_badge_form_view" model="ir.ui.view">
        <field name="name">Print Student Badge</field>
        <field name="model">print.student.badge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="slide_channel_ids" widget="many2many_tags" invisible="1"/>
                        <field name="slide_channel_id" required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="print_badge" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" type="object" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="print_student_badge_action">
        <field name="name">Print Student Badge</field>
        <field name="res_model">print.student.badge</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>