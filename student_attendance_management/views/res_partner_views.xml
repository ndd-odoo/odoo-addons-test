<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(student_attendance_management.print_student_badge_action)d" string="Print Student Badge" type="action" class="oe_highlight"/>
                </header>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <field name="student" widget="boolean_toggle"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='function']" position="after">
                <field name="job_id" string="Job Position" required="student" invisible="not student" placeholder='e.g. "Sales Director", "Trainee", ...'/>
            </xpath>
            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">student</attribute>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Attendance" name="attendance_details">
                    <group string="Attendance" name="identification_group">
                        <field name="pin" string="PIN Code"/>
                        <label for="badge_id"/>
                        <div class="o_row">
                            <field name="badge_id" string="Badge ID"/>
                            <button string="Generate" class="btn btn-link" type="object" name="generate_random_badge_id" invisible="badge_id"/>
                            <button name="%(res_partner_print_badge)d" string="Print Badge" class="btn btn-link" type="action" invisible="not badge_id"/>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_inherit" model="ir.ui.view">
        <field name="name">res.partner.select.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_company']" position="after">
                <filter string="Students" name="type_person" domain="[('student', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>